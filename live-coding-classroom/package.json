{
  "name": "live-coding-classroom",
  "displayName": "Live Coding Classroom",
  "description": "Share VS Code project file tree and file changes to students in real time.",
  "version": "0.4.1",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "liveCoding.startSession",
        "title": "Live Coding: Start Session",
        "icon": "$(play)"
      },
      {
        "command": "liveCoding.stopSession",
        "title": "Live Coding: Stop Session",
        "icon": "$(debug-stop)"
      },
      {
        "command": "liveCoding.copyStudentLink",
        "title": "Live Coding: Copy Student Link",
        "icon": "$(link)"
      },
      {
        "command": "liveCoding.hideFromStudents",
        "title": "Sembunyikan dari mahasiswa",
        "category": "Live Coding"
      },
      {
        "command": "liveCoding.showToStudents",
        "title": "Tampilkan ke mahasiswa",
        "category": "Live Coding"
      },
      {
        "command": "liveCoding.copyAccessCode",
        "title": "Live Coding: Copy Access Code",
        "icon": "$(key)"
      },
      {
        "command": "liveCoding.toggleSession",
        "title": "Live Coding: Start or Stop Session"
      },
      {
        "command": "liveCoding.refreshSession",
        "title": "Live Coding: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "Live Coding Classroom",
      "properties": {
        "liveCoding.backendUrl": {
          "type": "string",
          "default": "ws://localhost:3000",
          "description": "URL WebSocket backend. Contoh: ws://localhost:3000 atau wss://api.domainkamu.com"
        },
        "liveCoding.teacherToken": {
          "type": "string",
          "default": "dev-secret-token",
          "description": "Teacher token, harus sama dengan TEACHER_TOKEN di backend."
        },
        "liveCoding.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Pola file/folder TAMBAHAN yang tidak dibagikan (format .gitignore). Daftar bawaan seperti node_modules, vendor, build, .dart_tool, .env selalu dikecualikan."
        },
        "liveCoding.maxFileSizeKb": {
          "type": "number",
          "default": 512,
          "description": "Ukuran maksimal file teks yang dibagikan, dalam KB."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "liveCoding.hideFromStudents",
          "when": "resourceScheme == file && !(resourcePath in liveCoding.hiddenPaths)",
          "group": "liveCoding@1"
        },
        {
          "command": "liveCoding.showToStudents",
          "when": "resourceScheme == file && resourcePath in liveCoding.hiddenPaths",
          "group": "liveCoding@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "liveCoding.hideFromStudents",
          "when": "resourceScheme == file && !(resourcePath in liveCoding.hiddenPaths)",
          "group": "liveCoding@1"
        },
        {
          "command": "liveCoding.showToStudents",
          "when": "resourceScheme == file && resourcePath in liveCoding.hiddenPaths",
          "group": "liveCoding@2"
        }
      ],
      "commandPalette": [
        {
          "command": "liveCoding.hideFromStudents",
          "when": "resourceScheme == file"
        },
        {
          "command": "liveCoding.showToStudents",
          "when": "resourceScheme == file"
        },
        {
          "command": "liveCoding.refreshSession",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "liveCoding.startSession",
          "when": "view == liveCoding.session && !liveCoding.live",
          "group": "navigation@1"
        },
        {
          "command": "liveCoding.copyStudentLink",
          "when": "view == liveCoding.session && liveCoding.live",
          "group": "navigation@1"
        },
        {
          "command": "liveCoding.copyAccessCode",
          "when": "view == liveCoding.session && liveCoding.live",
          "group": "navigation@2"
        },
        {
          "command": "liveCoding.stopSession",
          "when": "view == liveCoding.session && liveCoding.live",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "liveCoding",
          "title": "Live Coding",
          "icon": "resources/live-coding.svg"
        }
      ]
    },
    "views": {
      "liveCoding": [
        {
          "id": "liveCoding.session",
          "name": "Sesi"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "liveCoding.session",
        "contents": "Belum ada sesi live.\n[Mulai sesi live](command:liveCoding.startSession)\n\nSesi berjalan dari workspace yang sedang terbuka."
      }
    ],
    "keybindings": [
      {
        "command": "liveCoding.toggleSession",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "ignore": "^5.3.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.0",
    "@vscode/vsce": "^2.32.0"
  }
}
