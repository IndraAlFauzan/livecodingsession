# Template environment production untuk docker-compose.yml.
# Salin menjadi .env.production lalu isi nilainya. JANGAN commit .env.production.
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production up -d --build
#
# Di Coolify, isi variabel yang sama lewat menu Environment Variables.

# ---------- Backend (runtime) ----------

PORT=3000

# Kunci halaman admin dan sesi live. Harus panjang dan acak, buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Token yang SAMA dipasang di VS Code: setting liveCoding.teacherToken.
TEACHER_TOKEN=replace-with-long-random-secret

# Alamat web mahasiswa, dipakai backend untuk membuat link pertemuan.
PUBLIC_BASE_URL=https://livecoding.devrisetiaf.cloud

MAX_FILE_SIZE_BYTES=524288
WS_HEARTBEAT_MS=30000

# DB_PATH tidak perlu diisi: docker-compose.yml menetapkan /app/data/livecoding.db (named volume).

# ---------- Frontend (build-time) ----------
# Nilai VITE_* ditanam ke file JavaScript saat build.
# Setiap perubahan nilainya membutuhkan build ulang image frontend.

# Alamat WebSocket backend. VS Code memakai alamat yang sama di setting liveCoding.backendUrl.
VITE_WS_URL=wss://belivecoding.devrisetiaf.cloud

# Alamat REST API backend.
VITE_API_URL=https://belivecoding.devrisetiaf.cloud
